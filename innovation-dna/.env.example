# Innovation DNA - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# DATABASE
# ============================================
DATABASE_URL=sqlite:///./innovation_dna.db

# ============================================
# AUTHENTICATION
# ============================================
AUTH_SECRET=your-secret-key-change-in-production-min-32-chars
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_HOURS=24

# ============================================
# AI / LLM CONFIGURATION
# ============================================
# Set to true to use mock AI (no API key needed)
MOCK_AI_MODE=true

# OpenAI API Key (required when MOCK_AI_MODE=false)
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# STORAGE
# ============================================
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# S3-compatible storage (when STORAGE_TYPE=s3)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ============================================
# APPLICATION
# ============================================
APP_NAME=Innovation DNA
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
